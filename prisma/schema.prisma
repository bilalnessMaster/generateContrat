generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users { 
  id        Int @id
  email     String 
  password  String
}

model contrat { 
    id              String      @id @default(cuid())
    nomEntreprise   String 
    typeEntreprise  String 
    budget          Int 
    propriétaire    String 
    téléphone       String 
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt
    statut          String?    @default("à contacter")
}